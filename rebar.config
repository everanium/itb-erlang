%% rebar.config — ITB Erlang binding (thin Triple Pipeline proxy over
%% the C binding via NIF).
%%
%% The NIF shim (c_src/itb_nif.c) is compiled by the c_src Makefile
%% through the compile pre-hook below — a plain Makefile keeps the
%% build dependency-free (no hex-fetched port-compiler plugin). The
%% Makefile links bindings/c/build/libitb_c.a statically and libitb.so
%% via -litb with an embedded RPATH into the repo dist dir.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, []}.

{pre_hooks, [
    {"(linux|darwin|solaris)", compile, "make -C c_src"},
    {"(linux|darwin|solaris)", clean, "make -C c_src clean"}
]}.

{eunit_opts, [verbose]}.
